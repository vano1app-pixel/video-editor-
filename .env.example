# --- AI planner (required) -------------------------------------------------
# The model that reads the transcript and decides the cuts.
ANTHROPIC_API_KEY=sk-ant-...
PLANNER_MODEL=claude-opus-5
# low | medium | high | xhigh | max  — lower is cheaper and faster.
PLANNER_EFFORT=high

# --- Transcription ---------------------------------------------------------
# auto = use OpenAI if OPENAI_API_KEY is set, else local whisper, else skip.
TRANSCRIBE_PROVIDER=auto

# Option A: hosted Whisper (easiest).
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Option B: self-hosted whisper.cpp / faster-whisper CLI.
# LOCAL_WHISPER_BIN=/usr/local/bin/whisper-cli
# LOCAL_WHISPER_MODEL=/models/ggml-base.en.bin

# --- Storage ---------------------------------------------------------------
# Mount a persistent volume here in production. Renders and uploads live under it.
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=2048

# --- ffmpeg ----------------------------------------------------------------
# Leave unset to use the bundled ffmpeg-static binaries. Set to use a system
# build (recommended in production — hardware encoders, newer filters).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_TIMEOUT_MIN=60

# --- Render ----------------------------------------------------------------
MAX_CONCURRENT_JOBS=1
RENDER_MAX_DIMENSION=1080
RENDER_FPS=30
RENDER_CRF=20
RENDER_PRESET=veryfast

# --- App -------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
